[gd_scene format=3 uid="uid://klc4vglmvoe1"]

[sub_resource type="GDScript" id="GDScript_07a6b"]
script/source = "# inventory_menu.gd
extends CanvasLayer

const ResourceData = preload(\"res://scripts/data/resource_data.gd\")

@onready var items_list: VBoxContainer = $Panel/VBox/ScrollContainer/ItemsList
@onready var money_label: Label = $Panel/VBox/HeaderHBox/MoneyLabel
@onready var capacity_label: Label = $Panel/VBox/CapacityLabel
@onready var sell_junk_button: Button = $Panel/VBox/ButtonHBox/SellJunkButton
@onready var close_button: Button = $Panel/VBox/ButtonHBox/CloseButton

var player: Node = null


func _ready() -> void:

	visible = false

	close_button.pressed.connect(close)
	sell_junk_button.pressed.connect(_on_sell_junk)


func _unhandled_input(event: InputEvent) -> void:

	# Toggle with the inventory action (we'll define this input below)
	if event.is_action_pressed(\"inventory\"):

		# don't open if other modals are showing
		var pause_menu := get_tree().current_scene.get_node_or_null(\"PauseMenu\") as CanvasLayer
		if pause_menu and pause_menu.visible:
			return

		var upgrade_menu := get_tree().current_scene.get_node_or_null(\"UpgradeMenu\") as CanvasLayer
		if upgrade_menu and upgrade_menu.visible:
			return

		if visible:
			close()
		else:
			open()

		get_viewport().set_input_as_handled()

	# Also close on Esc
	elif event.is_action_pressed(\"ui_cancel\") and visible:
		close()
		get_viewport().set_input_as_handled()


func open() -> void:

	# find player if we don't have a reference
	if not player or not is_instance_valid(player):
		player = get_tree().get_first_node_in_group(\"player\")

	if not player:
		push_error(\"InventoryMenu: no player found\")
		return

	visible = true
	rebuild()


func close() -> void:
	visible = false


func rebuild() -> void:

	if not player:
		return

	# clear current rows
	for child in items_list.get_children():
		child.queue_free()

	# header info
	money_label.text = \"$\" + str(player.money)
	capacity_label.text = \"Cargo: %d / %d\" % [player.cargo, player.max_cargo]

	# build rows in display order
	for material_id in ResourceData.DISPLAY_ORDER:

		var count: int = 0

		if material_id == \"basic_ore\":
			# special case: basic ore is stored in player.ore, not player.resources
			count = player.ore
		else:
			count = player.resources.get(material_id, 0)

		# skip empty buckets
		if count == 0:
			continue

		_add_row(material_id, count)


func _add_row(material_id: String, count: int) -> void:

	var data: Dictionary = ResourceData.RESOURCES.get(material_id, {})
	if data.is_empty():
		return

	var row := PanelContainer.new()
	var hbox := HBoxContainer.new()
	hbox.add_theme_constant_override(\"separation\", 8)
	row.add_child(hbox)

	# color swatch (placeholder for an icon)
	var swatch := ColorRect.new()
	swatch.color = data.get(\"color\", Color.WHITE)
	swatch.custom_minimum_size = Vector2(24, 24)
	hbox.add_child(swatch)

	# material name
	var name_label := Label.new()
	name_label.text = data.get(\"display_name\", material_id)
	name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	hbox.add_child(name_label)

	# count
	var count_label := Label.new()
	count_label.text = \"× \" + str(count)
	count_label.custom_minimum_size = Vector2(60, 0)
	hbox.add_child(count_label)

	# total sell value
	var unit_value: int = data.get(\"value\", 0)
	var total_value: int = unit_value * count

	var value_label := Label.new()
	value_label.text = \"$\" + str(total_value)
	value_label.custom_minimum_size = Vector2(80, 0)
	hbox.add_child(value_label)

	# sell button
	var sell_btn := Button.new()
	sell_btn.text = \"Sell\"
	sell_btn.custom_minimum_size = Vector2(80, 0)
	sell_btn.pressed.connect(_on_sell.bind(material_id))
	hbox.add_child(sell_btn)

	items_list.add_child(row)


func _on_sell(material_id: String) -> void:

	if not player:
		return

	var data: Dictionary = ResourceData.RESOURCES.get(material_id, {})
	var unit_value: int = data.get(\"value\", 0)

	var count: int
	if material_id == \"basic_ore\":
		count = player.ore
		player.ore = 0
	else:
		count = player.resources.get(material_id, 0)
		player.resources[material_id] = 0

	if count <= 0:
		return

	var total: int = unit_value * count
	player.money += total

	# reduce cargo (need to know cargo value per material — see note below)
	# For now, just refund some cargo proportionally
	_recompute_cargo()

	print(\"Sold \", count, \" \", material_id, \" for $\", total)

	rebuild()


func _on_sell_junk() -> void:

	if not player:
		return

	# sell only basic ore (the junk material)
	var count: int = player.ore
	if count <= 0:
		return

	var data: Dictionary = ResourceData.RESOURCES.get(\"basic_ore\", {})
	var unit_value: int = data.get(\"value\", 0)
	var total: int = unit_value * count

	player.money += total
	player.ore = 0

	_recompute_cargo()

	print(\"Sold all junk for $\", total)

	rebuild()


func _recompute_cargo() -> void:

	# Recompute cargo from scratch based on current materials
	# This requires knowing the cargo cost per material — defined in terrain_data.
	# Simple approach: cargo = basic_ore count + sum of resources
	# (Adjust if your cargo formula is more complex)

	var total_cargo: int = player.ore

	for r in player.resources.values():
		total_cargo += r

	player.cargo = total_cargo
"

